APP_NAME=AllerScan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://allerscan.test
APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=allerscan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=file
# AI research runs in the background: start a worker with `php artisan queue:work`.
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=debug
MAIL_MAILER=log

# First team account, created by `php artisan db:seed`. Local default only.
ADMIN_EMAIL=admin@allerscan.test
ADMIN_PASSWORD=AllerScanDemo2027!

# Shopper suggestion box and its team review page. Off for now.
SUGGESTIONS_ENABLED=false

# AI research for unregistered barcodes with Google Gemini (free tier). Create a key in Google AI Studio.
# Free-tier content may be used by Google to improve its products; the privacy page says so when this is on.
AI_LOOKUP_ENABLED=false
GEMINI_API_KEY=
AI_LOOKUP_DAILY_LIMIT=100
AI_LOOKUP_PER_PERSON_DAILY_LIMIT=10
