# Public deployment. Copy to .env on the server and fill in every blank value.
APP_NAME=AllerScan
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=daily
LOG_LEVEL=warning
MAIL_MAILER=log

# Shown on the Privacy & terms page.
CONTACT_EMAIL=

# Sends X-Robots-Tag: noindex. Set to false once the catalog holds real, checked products.
APP_NOINDEX=true

# First team account, created by `php artisan db:seed --force`.
# The seeder refuses to run until ADMIN_PASSWORD is a strong, unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
