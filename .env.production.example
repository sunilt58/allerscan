# Public demo deployment. Copy to .env on the server and fill in every blank value.
APP_NAME=AllerScan
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=daily
LOG_LEVEL=warning
MAIL_MAILER=log

# Only set to true for the first `php artisan db:seed --force`, then set back to false.
DEMO_ALLOW_SEED=false
# Required and must differ from the README password when DEMO_ALLOW_SEED=true.
DEMO_PASSWORD=
